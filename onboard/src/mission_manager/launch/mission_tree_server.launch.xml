<launch>
  <arg name="mission_server" default="true"/>

  <node pkg="mission_manager" exec="mission_tree_server" output="screen">
    <param from="$(find-pkg-share mission_manager)/config/mission_tree_server.yaml"/>
  </node>

  <group if="$(var mission_server)">
    <node pkg="mission_manager" exec="mission_server" output="screen"/>
  </group>
</launch>