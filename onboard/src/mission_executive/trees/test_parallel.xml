<root BTCPP_format="4">
  <BehaviorTree ID="TestParallel">
    <ReactiveSequence>
      <BatteryOK/>
      <Sequence>
        <!-- Navigate while detecting: both must succeed -->
        <Parallel success_count="2" failure_count="1">
          <RetryNode num_attempts="3">
            <Timeout msec="39000">
              <NavigateToWaypoint x="1.0" y="2.0" z="-1.0"/>
            </Timeout>
          </RetryNode>
          <Timeout msec="30000">
            <DetectObject target="GATE"/>
          </Timeout>
        </Parallel>

        <!-- After detection, send manipulation command -->
        <SendManipulatorCommand command="CLOSE"/>

        <!-- Navigate to next point -->
        <RetryNode num_attempts="3">
          <Timeout msec="39000">
            <NavigateToWaypoint x="3.0" y="4.0" z="-1.0"/>
          </Timeout>
        </RetryNode>

        <!-- Release -->
        <SendManipulatorCommand command="RELEASE"/>
      </Sequence>
    </ReactiveSequence>
  </BehaviorTree>
</root>
