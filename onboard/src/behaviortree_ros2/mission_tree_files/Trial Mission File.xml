<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="TrialTree">
  <BehaviorTree ID="GateTask">
    <Sequence>
      <DriveToWorldWaypoint world_waypoint="0,0,1,0,0,0"
                            waypoint_mask="1,1,1,1,1,1"
                            tolerance="0.2,0.2,0.2,0.1,0.1,0.1"
                            hold_time="1"
                            timeout="30"
                            _description="Descend to 1m"/>
      <DriveToWorldWaypoint world_waypoint="2,0,1,0,0,0"
                            waypoint_mask="1,1,1,1,1,1"
                            tolerance="0.2,0.2,0.2,0.1,0.1,0.1"
                            hold_time="1"
                            timeout="30"
                            _description="Drive forward 2m."/>
      <DurationTrick trick="ff_rollRight"
                            waypoint_mask="1,1,1,1,1,1"
                            tolerance="0.2,0.2,0.2,0.1,0.1,0.1"
                            hold_time="3"
                            duration ="3"
                            timeout="30"
                            _description="Roll"/>
      <DriveToWorldWaypoint world_waypoint="2,0,1,0,0,0"
                            waypoint_mask="1,1,1,1,1,1"
                            tolerance="0.2,0.2,0.2,0.1,0.1,0.1"
                            hold_time="1"
                            timeout="30"
                            _description="Stabilize"/>
      <DurationTrick trick="ff_pitchUp"
                            waypoint_mask="1,1,1,1,1,1"
                            tolerance="0.2,0.2,0.2,0.1,0.1,0.1"
                            hold_time="3.5"
                            duration="3.5"
                            timeout="30"
                            _description="Pitch Up"/>
      <DurationTrick trick="ff_pitchDown"
                            waypoint_mask="1,1,1,1,1,1"
                            tolerance="0.2,0.2,0.2,0.1,0.1,0.1"
                            hold_time="3.5"
                            duration="3.5"
                            timeout="30"
                            _description="Unwind Cable"/>
      <DriveToWorldWaypoint world_waypoint="2,0,1,0,0,0"
                            waypoint_mask="1,1,1,1,1,1"
                            tolerance="0.2,0.2,0.2,0.1,0.1,0.1"
                            hold_time="1"
                            timeout="30"
                            _description="Stabilize."/>
      <DriveToWorldWaypoint world_waypoint="5,0,1,0,0,0"
                            waypoint_mask="1,1,1,1,1,1"
                            tolerance="0.2,0.2,0.2,0.1,0.1,0.1"
                            hold_time="1"
                            timeout="30"
                            _description="Drive out to 5m"/>
      <DriveToWorldWaypoint world_waypoint="0,0,1,0,0,0"
                            waypoint_mask="1,1,1,1,1,0"
                            tolerance="0.2,0.2,0.2,0.1,0.1,0.1"
                            hold_time="1"
                            timeout="30"
                            _description="Drive back near start."/>
      <DriveToWorldWaypoint world_waypoint="0,0,0.2,0,0,0"
                            waypoint_mask="1,1,1,1,1,0"
                            tolerance="0.2,0.2,0.2,0.1,0.1,0.1"
                            hold_time="1"
                            timeout="30"
                            _description="Approach surface"/>
      <DriveToWorldWaypoint world_waypoint="0,0,0.2,0,0,0"
                            waypoint_mask="1,1,1,1,1,0"
                            tolerance="0.2,0.2,0.2,0.1,0.1,0.1"
                            hold_time="30"
                            timeout="0.1"
                            _description="Trigger a failure using short timeout to force idle."/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="ReturnToGateTask">
    <Sequence>
      <DriveToWorldWaypoint world_waypoint="0,0,0.2,0,0,0"
                            waypoint_mask="1,1,1,1,1,0"
                            tolerance="0.2,0.2,0.2,0.1,0.1,0.1"
                            hold_time="9999"
                            timeout="0.1"
                            _description="Trigger a failure using short timeout to force idle."/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TrialTree">
    <Sequence>
      <SubTree ID="GateTask"
               _autoremap="false"/>
      <SubTree ID="ReturnToGateTask"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="DriveToWorldWaypoint">
      <input_port name="world_waypoint"
                  type="std::vector&lt;float&gt;">[6x1] Target position and orientation in world frame</input_port>
      <input_port name="waypoint_mask"
                  type="std::vector&lt;bool&gt;">[6x1] Specifies which states the controller must prioritize</input_port>
      <input_port name="tolerance"
                  type="std::vector&lt;float&gt;">[6x1] Allowed error margin for arrival</input_port>
      <input_port name="hold_time"
                  type="float">Time to remain within tolerance before returning SUCCESS</input_port>
      <input_port name="timeout"
                  type="float">Time to attempt the task before giving up and returning FAILURE</input_port>
    </Action>
  </TreeNodesModel>

</root>
