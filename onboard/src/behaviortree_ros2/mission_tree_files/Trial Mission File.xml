<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="TrialTree">


  <BehaviorTree ID="GateTask">
    <Sequence>
      <DriveToWorldWaypoint world_waypoint_pos ="10,0,0"
                            world_waypoint_orient = "0,0,0"
                            waypoint_mask_pos="1,0,0"
                            waypoint_mask_orient="0,0,0"
                            tolerance_pos="0.2,0,0"
                            tolerance_orient="0,0,0"
                            hold_time="5"
                            _description="Forwards 10 metres"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TrialTree">
    <Sequence>
      <SubTree ID="GateTask"/>
      <SubTree ID="ReturnToGateTask"/>
    </Sequence>
  </BehaviorTree>

   <BehaviorTree ID="ReturnToGate">
    <Sequence>
      <DriveToWorldWaypoint world_waypoint_pos="0,0,0"
                            world_waypoint_orient="0,0,0"
                            waypoint_mask_pos="1,0,0"
                            waypoint_mask_orient="0,0,0"
                            tolerance_pos="0.2,0,0"
                            tolerance_orient="0,0,0"
                            hold_time="5"
                            _description="Return to origin"/>
    </Sequence>
  </BehaviorTree>


  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="DriveToWorldWaypoint">
      <input_port name="world_waypoint_pos"
                  type="std::vector&lt;float&gt;">[3x1] Target position and orientation in world frame</input_port>
      <input_port name="world_waypoint_orient"
                  type="std::vector&lt;float&gt;">[3x1] Target position and orientation</input_port>
      <input_port name="waypoint_mask_pos"
                  type="std::vector&lt;bool&gt;">[3x1] Specifies which states the controller must prioritize</input_port>
      <input_port name="waypoint_mask_orient"
                  type="std::vector&lt;bool&gt;">[3x1] Specifies which states the controller must prioritize</input_port>
      <input_port name="tolerance_pos"
                  type="std::vector&lt;float&gt;">[3x1] Allowed error margin for arrival</input_port>
      <input_port name="tolerance_orient"
                  type="std::vector&lt;float&gt;">[3x1] Allowed error margin for arrival</input_port>
      <input_port name="hold_time"
                  type="float">Time to remain within tolerance before returning SUCCESS</input_port>
    </Action>
  </TreeNodesModel>

</root>
