<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="FallbackTree">
    <Sequence>
      <SubTree ID="GoFallback"/>
      <SubTree ID="Return"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="GoFallback">
    <Fallback>
      <DriveToWorldWaypoint world_waypoint="10000000,0,0,0,0,0"
                            waypoint_mask="1,0,0,0,0,0"
                            tolerance="0.2,0,0,0,0,0"
                            hold_time="0.5"
                            timeout="5"/>
      <DriveToWorldWaypoint world_waypoint="10,0,0,0,0,0"
                            waypoint_mask="1,0,0,0,0,0"
                            tolerance="0.2,0,0,0,0,0"
                            hold_time="0.2"
                            timeout="10"/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="Return">
    <Sequence>
      <DriveToWorldWaypoint world_waypoint="0,0,0,0,0,0"
                            waypoint_mask="1,0,0,0,0,0"
                            tolerance="0.2,0,0,0,0,0"
                            hold_time="0.8"
                            timeout="8"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="DriveToWorldWaypoint">
      <input_port name="world_waypoint"
                  type="std::vector&lt;float&gt;">[6x1] Target position and orientation in world frame</input_port>
      <input_port name="waypoint_mask"
                  type="std::vector&lt;bool&gt;">[6x1] Specifies which states the controller must prioritize</input_port>
      <input_port name="tolerance"
                  type="std::vector&lt;float&gt;">[6x1] Allowed error margin for arrival</input_port>
      <input_port name="hold_time"
                  type="float">Time to remain within tolerance before returning SUCCESS</input_port>
      <input_port name="timeout"
                  type="float">Time to attempt the task before giving up and returning FAILURE</input_port>
    </Action>
  </TreeNodesModel>

</root>
